# M365 Custom Engine Agent — Environment Configuration
# Copy this file to .env and fill in your values.
# ⚠️ NEVER commit the .env file to source control.

# ─── Bot Identity (User-Assigned Managed Identity) ───────────────────────────
# The UAI client ID serves as the bot's App ID. No App Registration or
# client secret needed — Managed Identity handles token acquisition.
BOT_APP_ID=00000000-0000-0000-0000-000000000000
BOT_TENANT_ID=00000000-0000-0000-0000-000000000000

# The M365 Agents SDK reads these env vars for JWT validation.
# Set these to the same values as BOT_APP_ID and BOT_TENANT_ID.
MicrosoftAppId=00000000-0000-0000-0000-000000000000
MicrosoftAppTenantId=00000000-0000-0000-0000-000000000000

# The SDK's internal auth loader also reads these (belt-and-suspenders).
clientId=00000000-0000-0000-0000-000000000000
tenantId=00000000-0000-0000-0000-000000000000

# ─── A2A Orchestrator Endpoint ───────────────────────────────────────────────
# Base URL of the upstream A2A orchestrator service (no auth required for outbound)
A2A_BASE_URL=https://your-orchestrator.azurewebsites.net
# Path to the A2A JSON-RPC message/send endpoint
A2A_PATH=/a2a/orchestrator

# ─── Server ──────────────────────────────────────────────────────────────────
# Port for the Express server (Azure App Service overrides this to 8080 via PORT)
PORT=3978

# ─── App Package Build (used by appPackage/build-package.ps1) ────────────────
# Azure App Service name (without .azurewebsites.net)
APP_SERVICE_NAME=your-app-service-name
