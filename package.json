{
  "name": "m365-custom-engine-agent-bot-mi",
  "version": "1.0.0",
  "description": "M365 Custom Engine Agent — thin proxy to A2A orchestrator using User-Assigned Managed Identity",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "nodemon --exec ts-node src/index.ts",
    "watch": "tsc --watch",
    "clean": "rimraf dist"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@microsoft/agents-hosting": "^1.0.0",
    "@microsoft/agents-hosting-express": "^1.0.0",
    "@microsoft/agents-activity": "^1.0.0",
    "@azure/identity": "^4.0.0",
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "ts-node": "^10.9.0",
    "nodemon": "^3.1.0",
    "rimraf": "^5.0.0",
    "@types/node": "^20.0.0"
  },
  "keywords": [
    "m365",
    "custom-engine-agent",
    "a2a",
    "managed-identity",
    "teams"
  ],
  "license": "MIT"
}
